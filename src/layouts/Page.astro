---
// Gabarit d'une page de texte (contenu Markdown mis en forme par « prose »).
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<Base title={title} description={description} image={image}>
  <article>
    <h1 class="mb-6 text-3xl font-bold text-foret">{title}</h1>
    <div class="prose max-w-none prose-a:text-foret">
      <slot />
    </div>
  </article>
</Base>

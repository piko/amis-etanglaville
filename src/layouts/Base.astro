---
// Gabarit commun : <html>, <head> (SEO), en-tête et pied de page.
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BandeauAdhesion from '../components/BandeauAdhesion.astro';
import { accueil, site } from '../lib/data';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Variante de l'en-tête : « accueil » pour la page d'accueil. */
  variante?: 'accueil' | 'interieur';
  /** Bandeau « Rejoignez les Amis de l’Étang » en fin de page. */
  bandeau?: boolean;
  /** Classes de <main> (par défaut : pleine largeur, les sections gèrent leur gabarit). */
  classeMain?: string;
  /** Page indexée par la recherche du site (Pagefind). */
  indexer?: boolean;
}

const {
  title,
  description = site.description,
  image,
  variante = 'interieur',
  bandeau = true,
  classeMain = 'flex-1',
  indexer = true,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.nom}` : site.nom;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? accueil.hero.image, Astro.site);
// Tant que le domaine n'a pas basculé, le nouveau site n'est pas indexé
// (variable PUBLIC_INDEXABLE=true à définir dans Vercel, en production, à la bascule).
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font
      cssVariable="--font-public-sans"
      preload={[{ weight: 400, style: 'normal' }]}
    />
    <Font cssVariable="--font-newsreader" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:title" content={title ?? site.nom} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-creme focus:p-3 focus:font-bold"
    >
      Aller au contenu
    </a>
    <Header variante={variante} actif={Astro.url.pathname} />
    <main
      id="contenu"
      class={classeMain}
      data-pagefind-body={indexer ? '' : undefined}
    >
      <slot />
      {bandeau && <BandeauAdhesion />}
    </main>
    <Footer />
  </body>
</html>

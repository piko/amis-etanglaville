---
import { dateLongue } from '../lib/dates';
import { typo } from '../lib/texte';

interface Props {
  surtitre?: string;
  title: string;
  description?: string;
  updated?: Date;
  /** Double filet sous l'en-tête (pages de texte, bulletins). */
  filet?: boolean;
}

const { surtitre, title, description, updated, filet = true } = Astro.props;
const aside = Astro.slots.has('default');
// Page racine d'une rubrique : le surtitre répéterait le titre.
const memeTitre =
  surtitre?.toLocaleLowerCase('fr') === title.toLocaleLowerCase('fr');
---

<header
  class:list={[
    'py-7 md:py-9',
    filet && 'border-b-4 border-double border-encre',
    aside && 'flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between',
  ]}
>
  <div class="max-w-3xl">
    {surtitre && !memeTitre && (
      <p class="text-sm font-bold tracking-surtitre text-ocre-fonce uppercase">
        {surtitre}
      </p>
    )}
    <h1 class="mt-2 text-4xl leading-tight font-semibold text-balance md:text-6xl">
      {typo(title)}
    </h1>
    {description && (
      <p class="mt-4 font-titre text-xl leading-snug text-pretty text-gris md:text-2xl">
        {typo(description)}
      </p>
    )}
    {updated && (
      <p class="mt-3 text-sm text-gris">
        Mise à jour le{' '}
        <time datetime={updated.toISOString().slice(0, 10)}>
          {dateLongue(updated)}
        </time>
      </p>
    )}
  </div>
  <slot />
</header>

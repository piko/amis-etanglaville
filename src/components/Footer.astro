---
import { site } from '../lib/data';
---

<footer class="mt-12 bg-pierre">
  <div class="mx-auto grid max-w-5xl gap-6 px-4 py-8 text-sm sm:grid-cols-2 md:grid-cols-3">
    <div>
      <p class="font-titre font-bold text-foret">{site.nom}</p>
      <p>{site.nomCourt}, association depuis 1960</p>
      <p>{site.adresse}</p>
    </div>
    <div>
      <p class="font-bold">Contact</p>
      <p>
        <a href={`mailto:${site.email}`} class="underline">
          {site.email}
        </a>
      </p>
      {site.facebook && (
        <p>
          <a href={site.facebook} class="underline">
            Facebook
          </a>
        </p>
      )}
    </div>
    <div>
      <p class="font-bold">Soutenir l’association</p>
      <p>
        <a href={site.adhesion} class="underline">
          Adhérer
        </a>
      </p>
      <p>
        <a href={site.don} class="underline">
          Faire un don
        </a>
      </p>
    </div>
  </div>
</footer>

---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import EnTetePage from '../components/EnTetePage.astro';
import FilAriane from '../components/FilAriane.astro';
import Galerie from '../components/Galerie.astro';

const galerie = await getEntry('galeries', 'cartes-postales');
if (!galerie)
  throw new Error(
    'Galerie src/content/galeries/cartes-postales.yml introuvable',
  );
const { title, sections } = galerie.data;
const total = sections.reduce((n, s) => n + s.images.length, 0);
const description = `${total} cartes postales anciennes de L’Étang-la-Ville, classées en ${sections.length} thèmes. Touchez une carte pour l’agrandir.`;
---

<Base
  title={title}
  description={description}
  image={sections[0]?.images[0]?.src}
>
  <div class="mx-auto max-w-site px-4 pt-6 md:px-6">
    <FilAriane
      items={[
        { titre: 'Documentation', href: '/documentation/' },
        { titre: title },
      ]}
    />
    <EnTetePage
      surtitre="Mémoire du village"
      title={title}
      description={description}
      filet={false}
    />
  </div>
  <Galerie sections={sections} />
</Base>

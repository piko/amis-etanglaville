---
// Page d'accueil PROVISOIRE : accroche de src/content/pages/accueil.md et rubriques du menu.
// La version sur mesure (Hero, chiffres clés, dernier bulletin…) viendra du canevas de design.
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { hrefFor, menu, site } from '../lib/data';

const accueil = await getEntry('pages', 'accueil');
const { Content } = accueil ? await render(accueil) : { Content: null };
const rubriques = menu.filter((item) => item.link !== 'accueil');
---

<Base description={accueil?.data.description} variante="accueil">
  <section class="prose max-w-none prose-h1:text-foret">
    {Content && <Content />}
  </section>

  <section class="mt-10">
    <h2 class="mb-4 text-2xl font-bold text-foret">Découvrir</h2>
    <ul class="grid gap-4 sm:grid-cols-2 md:grid-cols-4">
      {rubriques.map((item) => (
        <li>
          <a
            href={hrefFor(item.link)}
            class="block rounded border border-pierre p-4 hover:border-foret"
          >
            {item.title}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-10 rounded bg-pierre p-6">
    <h2 class="text-2xl font-bold text-foret">Soutenir l’association</h2>
    <p class="mt-2">En ligne, via PayAsso :</p>
    <p class="mt-3 flex flex-wrap gap-3">
      <a href={site.adhesion} class="rounded bg-foret px-4 py-2 text-white">
        Adhérer
      </a>
      <a
        href={site.don}
        class="rounded border border-foret px-4 py-2 text-foret"
      >
        Faire un don
      </a>
    </p>
  </section>
</Base>

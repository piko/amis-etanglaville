---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contenu from '../../components/Contenu.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import FilAriane from '../../components/FilAriane.astro';
import { categories } from '../../lib/actualites';
import { finEvenement, isoSelon, moisEtAnnee, periode } from '../../lib/dates';
import { infosImage } from '../../lib/medias.mjs';

export async function getStaticPaths() {
  const actualites = await getCollection(
    'actualites',
    ({ data }) => !data.draft,
  );
  return actualites.map((a) => ({ params: { slug: a.id }, props: { a } }));
}

const { a } = Astro.props;
const { Content } = await render(a);
const {
  title,
  date,
  dateFin,
  datePrecision,
  lieu,
  categorie,
  image,
  imageAlt,
  resume,
  annule,
} = a.data;
const affiche = image ? await infosImage(image) : null;
const aVenir =
  !annule && finEvenement(date, dateFin, datePrecision) > new Date();

const quand =
  datePrecision === 'annee'
    ? String(date.getUTCFullYear())
    : datePrecision === 'mois'
      ? moisEtAnnee(date)
      : periode(date, dateFin);
---

<Base title={title} description={resume} image={image}>
  <div class="mx-auto max-w-site px-4 pt-6 md:px-6">
    <FilAriane
      items={[{ titre: 'Actualités', href: '/actualites/' }, { titre: title }]}
    />
    <EnTetePage
      surtitre={categories[categorie]}
      title={title}
      description={resume}
    >
      <dl class="flex flex-col gap-2 text-base lg:min-w-64">
        <div class="flex flex-wrap items-center gap-2">
          <dt class="sr-only">Date</dt>
          <dd class="font-bold">
            <time datetime={isoSelon(date, datePrecision)}>{quand}</time>
          </dd>
          {annule ? (
            <dd class="border border-encre px-2 py-0.5 text-xs font-bold tracking-surtitre uppercase">
              Pas d’édition en {date.getUTCFullYear()}
            </dd>
          ) : (
            aVenir && (
              <dd class="bg-foret px-2 py-0.5 text-xs font-bold tracking-surtitre text-papier uppercase">
                À venir
              </dd>
            )
          )}
        </div>
        {lieu && (
          <div>
            <dt class="sr-only">Lieu</dt>
            <dd class="text-gris">{lieu}</dd>
          </div>
        )}
      </dl>
    </EnTetePage>
  </div>
  <div
    class:list={[
      'mx-auto grid max-w-site gap-10 px-4 py-10 md:px-6 lg:gap-16',
      affiche && 'lg:grid-cols-[minmax(0,1fr)_20rem]',
    ]}
  >
    <div class="min-w-0">
      <Contenu>
        <Content />
      </Contenu>
      <p class="mt-12 max-w-texte border-t-3 border-encre pt-3">
        <a
          href="/actualites/"
          class="group font-titre text-xl font-semibold hover:text-foret hover:underline md:text-2xl"
        >
          ← Toutes les actualités
        </a>
      </p>
    </div>
    {affiche && (
      <figure class="lg:order-first lg:col-start-2 lg:row-start-1">
        <img
          src={affiche.src}
          srcset={affiche.srcset}
          sizes="(min-width: 1024px) 20rem, 100vw"
          width={affiche.width}
          height={affiche.height}
          alt={imageAlt ?? ''}
          class="mx-auto w-full max-w-sm border border-encre bg-sepia shadow-carte"
        />
      </figure>
    )}
  </div>
</Base>

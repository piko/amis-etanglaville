---
import Base from '../layouts/Base.astro';
import CartePostale from '../components/CartePostale.astro';
import Recherche from '../components/Recherche.astro';
import { site } from '../lib/data';

const liens = [
  { titre: 'Page d’accueil', href: '/' },
  { titre: 'Les bulletins', href: '/bulletins/' },
  { titre: 'Un peu d’histoire', href: '/un-peu-dhistoire/' },
  {
    titre: 'Cartes postales historiques',
    href: '/cartes-postales-historiques/',
  },
  { titre: 'Actualités', href: '/actualites/' },
  {
    titre: 'Signaler le lien cassé',
    href: `mailto:${site.email}?subject=${encodeURIComponent('Lien cassé')}`,
  },
];
---

<Base
  title="Page introuvable"
  bandeau={false}
  indexer={false}
  classeMain="mx-auto grid w-full max-w-site flex-1 items-center gap-12 px-4 py-12 md:px-6 lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-20 lg:py-20"
>
  <div>
    <p class="text-sm font-bold tracking-surtitre text-ocre-fonce uppercase">
      Erreur 404 · page introuvable
    </p>
    <h1 class="mt-3 text-4xl leading-tight font-semibold md:text-6xl">
      Cette page s’est égarée en forêt
    </h1>
    <p class="mt-5 max-w-texte text-lg">
      L’adresse demandée n’existe pas, ou elle a changé avec le nouveau site.
      Les anciens liens sont redirigés automatiquement&#8239;; si celui-ci ne
      l’est pas, signalez-le-nous.
    </p>
    <Recherche />
    <nav
      aria-labelledby="titre-chemin"
      class="mt-10 max-w-texte border-t border-encre pt-4"
    >
      <h2
        id="titre-chemin"
        class="font-texte text-xs font-bold tracking-surtitre text-ocre-fonce uppercase"
      >
        Retrouver son chemin
      </h2>
      <ul class="mt-2 grid font-bold sm:grid-cols-2 sm:gap-x-8">
        {liens.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex min-h-11 items-center text-foret underline-offset-4 hover:underline"
            >
              {l.titre}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="mx-auto w-full max-w-sm rotate-2 lg:max-w-none">
    <CartePostale
      src="/medias/2019/06/510-Etoile-du-Braconnier.jpg"
      legende="L’Étoile du Braconnier, en forêt de Marly : un carrefour où tous les chemins se rejoignent"
      reference="Carte postale ancienne, réf. 510"
      href="/cartes-postales-historiques/#la-foret"
      sizes="(min-width: 1024px) 26rem, 24rem"
      chargement="eager"
    />
  </div>
</Base>
